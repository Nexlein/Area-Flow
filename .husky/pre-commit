#!/bin/sh
# Blocks secrets and .env files, formats staged files with Prettier, keeps .claude/codemap.md in sync.
# Versioned hook: `npm install` points git's core.hooksPath at .husky (the "prepare" script), in every worktree.
set -e
sh .husky/no-secrets.sh
# A new worktree or clone has no node_modules yet: stop with the fix instead of letting npx download a package.
[ -e node_modules/.bin/lint-staged ] || { echo "pre-commit: dependencies missing, run npm ci first" >&2; exit 1; }
npx --no lint-staged
npm run -s codemap
git add .claude/codemap.md
