# Files git never tracks: secrets, dependencies, build output, local settings.

# Secrets & credentials (never commit them: SYS-SECRETS, SEC-CRYPTO)
.env
.env.*
!.env.example
*.secret
*.key
*.pem
*.p12
*.keystore
*.jks
credentials.json
client_secret*.json
service-account*.json
token.json
google-services.json
GoogleService-Info.plist
key.properties
keystore.properties
.envrc
mise.local.toml
# SSH keys, the Epitech mirror deploy key included (HOWTOCONTRIBUTE.md)
id_rsa*
id_ed25519*
area-mirror*

# Local databases: they hold users and OAuth tokens
*.db
*.sqlite
*.sqlite3

