{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(node scripts/*.ts*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch --show-current)",
      "Bash(git fetch*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.env.dev)",
      "Read(**/.env.ci)",
      "Read(**/.env.docker)",
      "Read(**/.envrc)",
      "Read(**/*.secret)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/key.properties)",
      "Read(**/keystore.properties)",
      "Read(**/credentials.json)",
      "Read(**/client_secret*.json)",
      "Read(**/service-account*.json)",
      "Read(**/token.json)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/area-mirror*)",
      "Read(**/node_modules/**)",
      "Read(./.git/**)",
      "Read(./package-lock.json)",
      "Bash(git -c*)",
      "Bash(git *--no-index*)",
      "Bash(git *--output*)",
      "Bash(git *--ext-diff*)",
      "Bash(git *--upload-pack*)",
      "Bash(docker compose config*)",
      "Bash(git commit *--no-v*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git push *--no-v*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(*GIT_CONFIG_*)",
      "Bash(*core.hooksPath*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-edit.ts\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
