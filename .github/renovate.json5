// Renovate (Mend app) keeps the tool versions of mise.toml up to date, one pull request per new release.
// Dependabot cannot read mise.toml; it still covers npm and the GitHub Actions (dependabot.yml).
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  enabledManagers: ['mise'],
  baseBranchPatterns: ['dev'], // PRs into the integration branch; the config itself is read from main
  dependencyDashboard: false,
  timezone: 'Europe/Paris',
  schedule: ['* 0-5 * * 1'], // Monday morning, like Dependabot
  semanticCommits: 'enabled',
  packageRules: [
    { matchManagers: ['mise'], semanticCommitType: 'build', semanticCommitScope: 'deps' },
  ],
}
